{
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0
    },
    "mappings": {
      "dynamic": true,
      "properties": {
        "timestamp": {
          "type": "date",
          "format": "strict_date_optional_time||epoch_millis"
        },
        "domain": {
          "type": "keyword"
        },
        "type": {
          "type": "keyword"
        }
      }
    }
  },
  "version": 1,
  "_meta": {
    "description": "Common NERP OpenSearch settings and shared fields"
  }
}
